{% from "components/container.njk" import container %}
{% from "components/button.njk" import button %}

{#
  YELP PARTNERS, at /yelp-partners/ AT ROOT LEVEL.

  NOT under /yelp/. That directory is the article tier and this is a page
  template, but more to the point the URL is the asset: it ranks for a Tier 1
  keyword on the live site.

  REBUILT 2026-08-02 TO FOLLOW THE COMP. The first version took the comp's copy
  and rebuilt the layout in a house idiom: a two-column direct answer instead of
  the comp's bordered mist panel, a table instead of the comparison's chip rows,
  two columns where the comp draws four, and no ink card in the party row. The
  comp is the authority on layout, hierarchy and spacing, and it was not
  followed. The structures below are the comp's.

  GROUNDS, AND THERE ARE THREE INK ONES IN THE COMP. The cost section is a full
  ink pane, the middle party card is an ink chip, and pricing's lead tier is
  outlined in 2px ink. design.md section 1 allows one deep PANE per view; a
  small ink card is not a pane, and the comp draws all three. Shipped as drawn.
  The one madder pane is the routing band, and its button is
  cs-btn--on-accent-primary, the filled primary for an accent ground.
#}

{#- 1 HERO. 1fr 320px, the badge is the right column at full width. -#}
{% call container(class="cs-yp-hero cs-yp-section cs-yp-section--first", orient="Yelp Advertising Partner") %}
  <div>
    <h1 class="cs-yp-hero__head">
      {{ hero.headBefore }} <span class="cs-yp-accent">{{ hero.headAccent }}</span> {{ hero.headAfter }}
    </h1>
    <p class="cs-yp-hero__lede">{{ hero.lede }}</p>
    <div class="cs-yp-hero__actions">
      {{ button(hero.primary, href="/contact/") }}
      {{ button(hero.secondary, href="#cost", variant="secondary") }}
    </div>
  </div>
  <div class="cs-yp-hero__aside">
    <img src="{{ site.cdn }}{{ credentials.items[0].image }}"
         alt="{{ credentials.items[0].alt }}"
         width="320" height="320" loading="eager" fetchpriority="high" decoding="async">
    <p class="cs-yp-hero__note">{{ hero.note }}</p>
  </div>
{% endcall %}

{#- 2 DIRECT ANSWER. One bordered mist panel, with the four requirements as a
    four-column grid inside it. -#}
{% call container(class="cs-yp-section", orient="What is a Partner?") %}
  <div class="cs-yp-answer">
    <h2 class="cs-yp-h2">{{ answer.title }}</h2>
    <p class="cs-yp-answer__body">{{ answer.body }}</p>
    <p class="cs-yp-answer__label">{{ answer.requiresTitle }}</p>
    <ul class="cs-yp-answer__grid">
      {%- for item in answer.requires %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </div>
{% endcall %}

{#- 2b IN PLAIN TERMS. 280px label column, then prose, then a three-up. -#}
{% call container(class="cs-yp-section", orient="In plain terms") %}
  <div class="cs-yp-plain">
    <div>
      <h2 class="cs-yp-h2">{{ plain.title }}</h2>
      <p class="cs-yp-plain__kicker">{{ plain.subtitle }}</p>
    </div>
    <div class="cs-yp-plain__prose">
      {%- for p in plain.body %}<p>{{ p }}</p>{% endfor %}
    </div>
  </div>
  <div class="cs-yp-triad">
    {%- for card in plain.cards %}
    <div class="cs-yp-triad__card">
      <p class="cs-eyebrow">{{ card.who }}</p>
      <p class="cs-yp-triad__body">{{ card.what }}</p>
    </div>
    {%- endfor %}
  </div>
{% endcall %}

{#- 3 WHAT PARTNERS GET. Four columns, Dual 200 at 40px, rule dividers. -#}
{% call container(class="cs-yp-section", orient="What partners get") %}
  <div class="cs-yp-head cs-yp-head--strong">
    <h2 class="cs-yp-h2">{{ partnersGet.title }}</h2>
    <p class="cs-yp-source">{{ partnersGet.source }}</p>
  </div>
  <ol class="cs-yp-four">
    {%- for item in partnersGet.items %}
    <li>
      <span class="cs-yp-four__n" aria-hidden="true">{{ loop.index }}</span>
      <span class="cs-yp-four__name">{{ item.name }}</span>
      <span class="cs-yp-four__body">{{ item.body }}</span>
    </li>
    {%- endfor %}
  </ol>
{% endcall %}

{#- 4 WHAT IT MEANS FOR THE CLIENT. Three-column rows, and the partner cell is
    a mist chip. A dl rather than a table: it is seven label/value/value rows
    read top to bottom, not a grid anyone scans by column header. -#}
{% call container(class="cs-yp-section", orient="What that means") %}
  <h2 class="cs-yp-h2">{{ compare.title }}</h2>
  <p class="cs-yp-lede">{{ compare.lede }}</p>
  <div class="cs-yp-cmp">
    <div class="cs-yp-cmp__head" aria-hidden="true">
      <span></span>
      <span>{{ compare.colA }}</span>
      <span>{{ compare.colB }}</span>
    </div>
    <dl class="cs-yp-cmp__rows">
      {%- for row in compare.rows %}
      <div class="cs-yp-cmp__row">
        <dt>{{ row.label }}</dt>
        <dd class="cs-yp-cmp__a" data-col="{{ compare.colA }}">{{ row.a }}</dd>
        <dd class="cs-yp-cmp__b" data-col="{{ compare.colB }}">{{ row.b }}</dd>
      </div>
      {%- endfor %}
    </dl>
  </div>
{% endcall %}

{#- 4b THE ONE MADDER PANE. 1.15fr 1fr. -#}
{% call container(class="cs-yp-section", orient="Why clients call") %}
  <div class="cs-yp-route">
    <div>
      <p class="cs-yp-route__eyebrow">{{ route.eyebrow }}</p>
      <p class="cs-yp-route__title">{{ route.title }}</p>
      <p class="cs-yp-route__body">{{ route.body }}</p>
      {{ button(route.cta, href="/contact/", variant="on-accent-primary", class="cs-yp-route__cta") }}
      <p class="cs-yp-route__note">{{ route.note }}</p>
    </div>
    <div class="cs-yp-route__steps">
      <p class="cs-yp-route__steps-title">{{ route.stepsTitle }}</p>
      <ol>
        {%- for step in route.steps %}<li>{{ step }}</li>{% endfor %}
      </ol>
    </div>
  </div>
{% endcall %}

{#- 4c WHO YOU GET AT YELP. Three party cards with connectors between them, and
    the middle one is ink because it is us. Then the two-column comparison. -#}
{% call container(class="cs-yp-section", orient="Who you get at Yelp") %}
  <h2 class="cs-yp-h2">{{ whoTitle }}</h2>
  <p class="cs-yp-lede">{{ whoLede }}</p>
  <div class="cs-yp-parties">
    {%- for p in whoTable %}
    <div class="cs-yp-parties__card{{ " cs-yp-parties__card--ours" if loop.index == 2 }}">
      <p class="cs-yp-parties__party">{{ p.party }}</p>
      <p class="cs-yp-parties__role">{{ p.role }}</p>
      <p class="cs-yp-parties__body">{{ p.body }}</p>
    </div>
    {%- if not loop.last %}<span class="cs-yp-parties__link" aria-hidden="true"></span>{% endif %}
    {%- endfor %}
  </div>
  <div class="cs-yp-versus">
    {%- for col in whoCompare %}
    <div class="cs-yp-versus__col">
      <p class="cs-eyebrow">{{ col.title }}</p>
      <p class="cs-yp-versus__who">{{ col.who }}</p>
      <ul>
        {%- for point in col.points %}<li>{{ point }}</li>{% endfor %}
      </ul>
    </div>
    {%- endfor %}
  </div>
{% endcall %}

{#- 5 COST, THE ONE INK PANE. Three facts across. -#}
{% call container(class="cs-yp-section", orient="Does it cost more?") %}
  <div class="cs-yp-cost" id="cost">
    <p class="cs-yp-cost__eyebrow">{{ cost.eyebrow }}</p>
    <h2 class="cs-yp-cost__title">{{ cost.title }}</h2>
    <p class="cs-yp-cost__lede">{{ cost.lede }}</p>
    <div class="cs-yp-cost__facts">
      {%- for fact in cost.facts %}
      <div class="cs-yp-cost__fact">
        <p class="cs-yp-cost__label">{{ fact.label }}</p>
        <p class="cs-yp-cost__fact-title">{{ fact.title }}</p>
        <p class="cs-yp-cost__fact-body">{{ fact.body }}</p>
      </div>
      {%- endfor %}
    </div>
    <p class="cs-yp-cost__close">{{ cost.close }}</p>
    <p><a class="cs-yp-cost__cta" href="#pricing">{{ cost.cta }} <span aria-hidden="true">&rarr;</span></a></p>
  </div>
{% endcall %}

{#- 6 CREDENTIALS. Each badge sits in a white chip. -#}
{% call container(class="cs-yp-section", orient="Credentials") %}
  <h2 class="cs-yp-h2 cs-yp-h2--rule">{{ credentials.title }}</h2>
  <div class="cs-yp-creds">
    {%- for c in credentials.items %}
    <div class="cs-yp-creds__card">
      <span class="cs-yp-creds__chip">
        <img src="{{ site.cdn }}{{ c.image }}" alt="{{ c.alt }}"
             width="72" height="72" loading="lazy" decoding="async">
      </span>
      <div>
        <p class="cs-yp-creds__name">{{ c.name }}</p>
        <p class="cs-yp-creds__body">{{ c.body }}</p>
      </div>
    </div>
    {%- endfor %}
  </div>
{% endcall %}

{#- 7 PROOF. Four across. -#}
{% call container(class="cs-yp-section", orient="Why Yelp is worth it") %}
  <div class="cs-yp-head">
    <h2 class="cs-yp-h2">{{ proof.title }}</h2>
    <p class="cs-yp-source">{{ proof.lede }}</p>
  </div>
  <div class="cs-yp-stats">
    {%- for s in proof.stats %}
    <div class="cs-yp-stats__item">
      <p class="cs-yp-stats__value">{{ s.value }}</p>
      <p class="cs-yp-stats__label">{{ s.label }}</p>
      <p class="cs-yp-stats__source">{{ proof.source }}</p>
    </div>
    {%- endfor %}
  </div>
{% endcall %}

{#- 8 WHAT WE DO. Three across. -#}
{% call container(class="cs-yp-section", orient="On a managed account") %}
  <h2 class="cs-yp-h2 cs-yp-h2--rule">{{ managed.title }}</h2>
  <div class="cs-yp-grid">
    {%- for item in managed.items %}
    <div class="cs-yp-grid__item">
      <p class="cs-yp-grid__name">{{ item.name }}</p>
      <p class="cs-yp-grid__body">{{ item.body }}</p>
    </div>
    {%- endfor %}
  </div>
{% endcall %}

{#- 9 PRICING. The first tier is the LEAD and the comp gives it three things,
    not one: the 2px ink outline, a madder eyebrow, and the madder-filled
    button. The 2026-08-02 rebuild caught the outline and missed the other two,
    so the lead card read as an ordinary card with a heavier border.

    THE BUTTON IS PRIMARY ON THE LEAD ONLY. button.njk reserves the madder fill
    for the single CTA moment, and three filled buttons in a row would flatten
    the hierarchy the outline exists to build. Same scarcity the hub follows
    with its one madder eyebrow.

    EVERY UNIT CARRIES ITS FOOTNOTE MARKER. There are three footnotes and three
    tiers and they correspond one to one: per-location pricing on setup, the
    minimum spend behind the $0 management fee, the monthly billing terms on
    review management. Until now the list sat at the bottom attached to nothing,
    which is a qualifier a reader has no way to connect to the number it
    qualifies. The marker reuses .cs-fnref, the article system's own, so the
    two read identically; it is hand-numbered rather than transform-numbered
    because the transform matches `data-fn` markers only and there is no
    document order to discover here, the tier's own index is the number. -#}
{% call container(class="cs-yp-section", orient="What we charge") %}
  <div class="cs-yp-head" id="pricing">
    <h2 class="cs-yp-h2">{{ pricing.title }}</h2>
    <p class="cs-yp-source">{{ pricing.note }}</p>
  </div>
  <div class="cs-yp-tiers">
    {%- for tier in pricing.tiers %}
    <div class="cs-yp-tiers__card{{ " cs-yp-tiers__card--lead" if loop.first }}">
      <p class="cs-eyebrow">{{ tier.kicker }}</p>
      <p class="cs-yp-tiers__name">{{ tier.name }}</p>
      <p class="cs-yp-tiers__price">
        <span class="cs-yp-tiers__figure">{{ tier.price }}</span>
        <span class="cs-yp-tiers__unit">{{ tier.unit }}<a class="cs-fnref cs-yp-tiers__marker" href="#yp-note-{{ loop.index }}" role="doc-noteref" aria-label="Note {{ loop.index }}">{{ loop.index }}</a></span>
      </p>
      <p class="cs-yp-tiers__body">{{ tier.body }}</p>
      {{ button(pricing.cta, href="/contact/", variant=("primary" if loop.first else "secondary"), class="cs-yp-tiers__cta") }}
    </div>
    {%- endfor %}
  </div>
  <ol class="cs-yp-footnotes">
    {%- for note in pricing.footnotes %}<li id="yp-note-{{ loop.index }}" role="doc-endnote">{{ note }}</li>{% endfor %}
  </ol>
{% endcall %}

{#- 10 FAQ -#}
{% call container(class="cs-yp-section", orient="Common questions") %}
  <div class="cs-yp-head">
    <h2 class="cs-yp-h2">{{ faqTitle }}</h2>
    <p class="cs-yp-source"><a href="/yelp/">{{ faqLink }} <span aria-hidden="true">&rarr;</span></a></p>
  </div>
  <div class="cs-yp-faq">
    {#- One <p> PER PARAGRAPH, not one per answer. Two of these answers are
        written in several paragraphs and the folded scalars keep the breaks as
        newlines; rendering item.a into a single <p> collapsed them to spaces
        and turned a four-paragraph answer on billing into a wall.

        The schema below still reads item.a whole, so the encoded answer and the
        visible answer remain the same text, which is what CLAUDE.md requires.

        The answer text is in the DOM for every item, open or closed. <details>
        hides its content by styling, not by removing it, so a crawler and a
        screen reader both see all seven answers. -#}
    {%- for item in faq %}
    <details class="cs-yp-faq__item">
      <summary>{{ item.q }}</summary>
      <div class="cs-yp-faq__a">
        {%- for para in item.a.split("\n") %}{% if para | trim %}<p>{{ para | trim }}</p>{% endif %}{% endfor %}
      </div>
    </details>
    {%- endfor %}
  </div>
{% endcall %}

{#- 11 CTA -#}
{% call container(class="cs-yp-section") %}
  <div class="cs-yp-close">
    <p class="cs-yp-close__statement">{{ closing.statement }}</p>
    <div>
      <p class="cs-yp-close__body">{{ closing.body }}</p>
      <div class="cs-yp-close__actions">
        {{ button(closing.cta, href="/contact/") }}
        <p class="cs-eyebrow">{{ closing.note }}</p>
      </div>
    </div>
  </div>
{% endcall %}

{#- FAQPage, from the SAME array the visible FAQ renders from. -#}
{%- set faqEntities = [] -%}
{%- for item in faq -%}
  {%- set _ = faqEntities.push({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }) -%}
{%- endfor %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": (page.url | absoluteUrl) + "#faq",
  "mainEntity": faqEntities
} | jsonld | safe }}
</script>
